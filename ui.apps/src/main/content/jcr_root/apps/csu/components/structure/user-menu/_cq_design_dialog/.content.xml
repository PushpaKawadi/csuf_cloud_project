<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="User Menu"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <login
                        jcr:primaryType="nt:unstructured"
                        jcr:title="User Menu"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <greeting
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        emptyText="Hello, "
                                        fieldDescription="Text to display next to user name."
                                        fieldLabel="Greeting"
                                        name="./greeting"/>
                                    <login-label
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        emptyText="Log in"
                                        fieldDescription="Log in link label."
                                        fieldLabel="Log In Label"
                                        name="./logInLabel"
                                        required="{Boolean}true"/>
                                    <login-url
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldDescription="Path to log in page."
                                        fieldLabel="Log In Page"
                                        name="./logInLink"
                                        required="{Boolean}true"
                                        rootPath="/content"/>
                                    <logout-label
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        emptyText="Log out"
                                        fieldDescription="Log out link label."
                                        fieldLabel="Log Out Label"
                                        name="./logOutLabel"
                                        required="{Boolean}true"/>
                                    <logout-url
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldDescription="Path to log out page."
                                        fieldLabel="Log Out Page"
                                        name="./logOutLink"
                                        required="{Boolean}true"
                                        rootPath="/content"/>
                                </items>
                            </column>
                        </items>
                    </login>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
