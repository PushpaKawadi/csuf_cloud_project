    "end",
    "set ACL for csuf-forms-reader",
    "    allow jcr:read on /",
    "end",
	"create path (sling:OrderedFolder) /content/dam/csuf-cloud-project",
   "create path (nt:unstructured) /content/dam/csuf-cloud-project/jcr:content",
   "set properties on /content/dam/csuf-cloud-project/jcr:content\n  set cq:conf{String} to /conf/csuf-cloud-project\n  set jcr:title{String} to \"CSUF Cloud Project\"\nend"
  ]
